{
  "$schema": "node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.8.0",
    "generators": {
      "v3.0": {
        "generatorName": "typescript-fetch",
        "output": "./src/generated/openapi/",
        "inputSpec": "https://raw.githubusercontent.com/loyaltyengine/openapi-specifications/main/auth-service/auth_service_v1.yaml",
        "additionalProperties": {
            "modelPropertyNaming": "camelCase",
            "supportsES6": true,
            "enumNameSuffix": "Enum",
            "enumPropertyNaming": "PascalCase",
            "withInterfaces": true
        }
      }
    }
  }
}